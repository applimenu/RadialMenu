<Window x:Class="RadialMenu1.MetricWidget" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RadialMenu1"
        Width="228" Height="126" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="Manual" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
        Foreground="{DynamicResource WidgetText}">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="WidgetMenuStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="WidgetButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource WidgetText}"/>
            <Setter Property="Background" Value="{DynamicResource WidgetButtonFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WidgetOutline}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Padding="{TemplateBinding Padding}" CornerRadius="7"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource WidgetButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="WidgetMenu" Style="{StaticResource WidgetContextMenu}" Placement="MousePoint"
                     Opened="WidgetMenuOpened">
            <MenuItem x:Name="PrimaryAction" Header="Открыть" Icon="&#xE8A7;" Click="OpenMetric"/>
            <MenuItem Header="Настроить виджет…" Icon="&#xE790;" Click="ConfigureWidget"/>
            <Separator Style="{StaticResource WidgetMenuDivider}"/>
            <MenuItem x:Name="SmallSize" Header="Маленький" IsCheckable="True" Click="ResizeWidget"/>
            <MenuItem x:Name="MediumSize" Header="Средний" IsCheckable="True" Click="ResizeWidget"/>
            <MenuItem x:Name="LargeSize" Header="Большой" IsCheckable="True" Click="ResizeWidget"/>
            <MenuItem x:Name="DesktopCompact" Header="Компактный вид на рабочем столе" IsCheckable="True" Click="ChangeDesktopCompact"/>
            <Separator Style="{StaticResource WidgetMenuDivider}"/>
            <MenuItem Header="Изменить виджеты…" Icon="&#xE70F;" Click="ManageWidgets"/>
            <MenuItem Header="Убрать виджет" Icon="&#xE738;" Click="CloseWidget"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="Card" CornerRadius="14" BorderThickness="1" Padding="11,7,11,8" RenderTransformOrigin=".5,.5"
            Background="{DynamicResource WidgetSurface}" BorderBrush="{DynamicResource WidgetOutline}">
        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
        <Grid ClipToBounds="True">
        <Grid x:Name="FullContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel x:Name="Header" Background="Transparent" Cursor="SizeAll" LastChildFill="True"
                       MouseLeftButtonDown="DragHeader" MouseMove="HeaderMove" MouseLeftButtonUp="HeaderUp"
                       LostMouseCapture="HeaderLostCapture" ToolTip="Потяните для перемещения. Правый клик — меню виджета.">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="24" Height="24"
                        Style="{StaticResource WidgetButton}" ToolTip="Закрыть виджет"
                        AutomationProperties.Name="Закрыть виджет" Click="CloseWidget">
                    <Path Width="8" Height="8" Stretch="Fill" Data="M 0,0 L 8,8 M 8,0 L 0,8"
                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Ellipse Width="7" Height="7" Fill="{DynamicResource WidgetAccent}" Margin="1,0,7,0"
                         VerticalAlignment="Center"/>
                <TextBlock x:Name="MetricTitle" Margin="0,0,5,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource WidgetAccent}" FontSize="12" FontWeight="SemiBold"/>
            </DockPanel>

            <Grid Grid.Row="1" Margin="1,3,1,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="MetricValue" Text="—" FontSize="26" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" TextOptions.TextFormattingMode="Display"/>
                <TextBlock x:Name="MetricDetail" Grid.Row="1" Text="Ожидание данных" Opacity="0.9"
                           FontSize="11" TextTrimming="CharacterEllipsis"/>
            </Grid>

            <local:WidgetGraph x:Name="History" Grid.Row="2" Margin="1,0"/>
            <StackPanel x:Name="TimerControls" Grid.Row="2" Visibility="Collapsed" Margin="1,0" VerticalAlignment="Bottom"
                        PreviewMouseWheel="ChangeTimerByWheel">
                <ProgressBar x:Name="TimerProgress" Height="3" Maximum="1" IsHitTestVisible="False">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border x:Name="PART_Track" CornerRadius="1.5" Background="{DynamicResource WidgetOutline}">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="1.5"
                                        Background="{DynamicResource WidgetAccent}"/>
                            </Border>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <Grid Margin="0,6,0,0" Height="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PreviousDuration" Content="−" FontSize="14" Margin="0,0,4,0"
                            Style="{StaticResource WidgetButton}" ToolTip="Предыдущая длительность"
                            AutomationProperties.Name="Предыдущая длительность" Click="PreviousTimerPreset"/>
                    <Button x:Name="NextDuration" Grid.Column="1" Content="+" FontSize="14" Margin="0,0,4,0"
                            Style="{StaticResource WidgetButton}" ToolTip="Следующая длительность"
                            AutomationProperties.Name="Следующая длительность" Click="NextTimerPreset"/>
                    <Button x:Name="TimerToggle" Grid.Column="2" Content="Старт"
                            Style="{StaticResource WidgetButton}" Click="ToggleTimer"/>
                </Grid>
            </StackPanel>
        </Grid>
        <Grid x:Name="CompactContent" Visibility="Collapsed" Background="Transparent" Cursor="SizeAll"
              MouseLeftButtonDown="DragHeader" MouseMove="HeaderMove" MouseLeftButtonUp="HeaderUp"
              LostMouseCapture="HeaderLostCapture">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Text, ElementName=MetricTitle}" Foreground="{DynamicResource WidgetAccent}"
                       FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Text, ElementName=MetricValue}" FontSize="18" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        </Grid>
        </Grid>
    </Border>
</Window>
