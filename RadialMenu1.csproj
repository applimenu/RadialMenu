<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<ApplicationIcon>app.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.2.5</Version>
    <UpdateRepository Condition="'$(UpdateRepository)' == ''">applimenu/RadialMenu</UpdateRepository>
    <ReportEndpoint Condition="'$(ReportEndpoint)' == '' And '$(UpdateRepository)' == 'applimenu/RadialMenu'">https://radialmenu-feedback.applimenu-radialmenu.workers.dev/reports</ReportEndpoint>
    <DefaultItemExcludes>$(DefaultItemExcludes);relay/**;installer/UpdateHost/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <None Remove="app.ico" />
  </ItemGroup>
  <ItemGroup Condition="'$(UpdateRepository)' != ''">
    <AssemblyMetadata Include="RadialMenuUpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UpdateRepository)' == 'applimenu/RadialMenu'">
    <AssemblyMetadata Include="RadialMenuUpdateRepositoryId" Value="1466494204" />
  </ItemGroup>
  <ItemGroup Condition="'$(ReportEndpoint)' != ''">
    <AssemblyMetadata Include="RadialMenuReportEndpoint" Value="$(ReportEndpoint)" />
  </ItemGroup>
  <ItemGroup Condition="'$(ReportBotUsername)' != ''">
    <AssemblyMetadata Include="RadialMenuReportBot" Value="$(ReportBotUsername)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
