<Window x:Class="RadialMenu1.RunningAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить приложение" Width="460" Height="420" MinWidth="360" MinHeight="320"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" FontSize="13"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource ThemeWindow}" Foreground="{DynamicResource ThemeText}">
    <Window.Resources>
        <ResourceDictionary Source="SettingsStyles.xaml"/>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,9">
            <TextBlock x:Name="Heading" Text="Запущенные приложения" Style="{StaticResource SectionTitle}"/>
            <TextBox x:Name="SearchBox" AutomationProperties.Name="Поиск по имени приложения"
                     TextChanged="FilterChanged" ToolTip="Например, Telegram"/>
            <TextBlock x:Name="Status" Margin="0,6,0,0" Foreground="{DynamicResource ThemeMuted}"
                       TextWrapping="Wrap" Text="Введи имя приложения, например Telegram."/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Padding="6">
            <ListBox x:Name="AppList" AutomationProperties.Name="Запущенные приложения"
                     SelectionChanged="SelectionChanged" MouseDoubleClick="AppList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,9,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Details}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource ThemeMuted}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,9,0,0">
            <Button DockPanel.Dock="Right" Content="Отмена" IsCancel="True" Margin="6,0,0,0"/>
            <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Добавить" IsDefault="True"
                    IsEnabled="False" Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
            <CheckBox x:Name="ShowBackground" Content="Фоновые процессы" VerticalAlignment="Center"
                      Checked="FilterChanged" Unchecked="FilterChanged"/>
        </DockPanel>
    </Grid>
</Window>
