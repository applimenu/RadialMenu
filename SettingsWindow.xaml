<Window x:Class="RadialMenu1.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RadialMenu1"
        Title="RadialMenu — настройки" Icon="/RadialMenu1;component/app.ico" Width="1100" Height="660" MinWidth="620" MinHeight="470"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        Foreground="{DynamicResource ThemeText}" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:EntryIconConverter x:Key="EntryIcon"/>
            <ContextMenu x:Key="ModeActions" Opened="ModeMenu_Opened">
                <MenuItem Header="Сделать активным" Click="ActivateMode_Click"/>
                <MenuItem Header="Переименовать" Click="RenameMode_Click"/>
                <MenuItem Header="Удалить" Click="DeleteMode_Click"/>
            </ContextMenu>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="WindowSurface" Margin="18,12,18,14" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="WindowScale"/>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="PreviewGutter" Width="14"/>
            <ColumnDefinition x:Name="PreviewColumn" Width="304"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="BottomPreviewRow" Height="0"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="3" Grid.RowSpan="4" Margin="-15,-8,-15,-13" CornerRadius="24"
                Background="#41000000" IsHitTestVisible="False"/>
        <Border Grid.ColumnSpan="3" Grid.RowSpan="4" Margin="-16,-10,-16,-11" CornerRadius="23"
                Background="{DynamicResource SettingsGlass}" BorderBrush="{DynamicResource SettingsEdge}" BorderThickness="1"/>

        <DockPanel Grid.ColumnSpan="3" Height="38" Margin="3,0,1,10" Background="Transparent"
                   MouseLeftButtonDown="PreviewHeader_MouseLeftButtonDown">
            <Button x:Name="CloseSettingsButton" DockPanel.Dock="Right" Width="32" Height="30" Padding="0"
                    ToolTip="Закрыть настройки" AutomationProperties.Name="Закрыть настройки" Click="CloseSettings_Click">
                <Path Data="M 1,1 L 10,10 M 10,1 L 1,10" StrokeThickness="1.4" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
            <Button x:Name="PreviewToggle" DockPanel.Dock="Right" Margin="0,0,8,0" Height="30"
                    VerticalAlignment="Center" Click="PreviewToggle_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PreviewToggleLabel" Margin="7,0,0,0" Text="Скрыть просмотр"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/RadialMenu1;component/app.ico" Width="25" Height="25" Margin="0,0,9,0"/>
                <TextBlock Text="RadialMenu" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Width="1" Height="14" Background="{DynamicResource ThemeBorder}" Margin="12,0"/>
                <TextBlock Text="Настройки" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" x:Name="SettingsTabs" TabStripPlacement="Left" SelectionChanged="SettingsTabs_SelectionChanged"
                    SizeChanged="SettingsTabs_SizeChanged">
            <TabItem x:Name="ThemeTab" Header="Внешний вид" Tag="&#xE790;">
                <ScrollViewer Style="{StaticResource SettingsPageScroll}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="Темы" Style="{StaticResource SectionTitle}"/>
                                <ListBox x:Name="ThemeList" ItemTemplate="{StaticResource ThemeTile}" SelectedValuePath="Value"
                                         AutomationProperties.Name="Оформление"
                                         SelectionChanged="ThemeList_SelectionChanged">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Margin" Value="0,0,5,4"/>
                                            <Setter Property="Padding" Value="4"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Стиль меню" Style="{StaticResource SectionTitle}"/>
                                <ListBox x:Name="MenuStyleList" ItemContainerStyle="{StaticResource ChoiceChip}" SelectedValuePath="Tag"
                                         AutomationProperties.Name="Стиль меню"
                                         SelectionChanged="MenuStyleList_SelectionChanged">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBoxItem Content="Классический" Tag="{x:Static local:MenuStyle.Classic}"/>
                                    <ListBoxItem Content="Кружки" Tag="{x:Static local:MenuStyle.Circles}"/>
                                    <ListBoxItem Content="Соты" Tag="{x:Static local:MenuStyle.Honeycomb}"/>
                                    <ListBoxItem Content="Кольцо" Tag="{x:Static local:MenuStyle.Ring}"/>
                                </ListBox>
                                <StackPanel Margin="0,8,0,0">
                                    <CheckBox x:Name="AnimationsToggle" Content="Анимации и свечение"/>
                                    <CheckBox x:Name="SelectionEffectsToggle" Content="Всплеск при выборе"
                                              ToolTip="Волна с частицами при выборе ярлыка"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource ThemeMuted}"
                                               Text="{Binding Value, ElementName=MenuScale, StringFormat={}{0:0}%}"/>
                                    <TextBlock Text="Размер колеса" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Slider x:Name="MenuScale"
                                        IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                        AutomationProperties.Name="Размер колеса в процентах"/>
                                <DockPanel Margin="0,7,0,0">
                                    <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource ThemeMuted}"
                                               Text="{Binding Value, ElementName=MenuTransparency, StringFormat={}{0:0}%}"/>
                                    <TextBlock Text="Прозрачность фона" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Slider x:Name="MenuTransparency" Minimum="0" Maximum="100" TickFrequency="1"
                                        SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True" AutomationProperties.Name="Прозрачность фона в процентах"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="AutoColorCard" Style="{StaticResource PanelCard}" Margin="0,7,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Хамелеон · Авто" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Цвета берутся из активного окна или обоев рабочего стола."
                                           Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ManualColorCard" Style="{StaticResource PanelCard}" Margin="0,7,0,0">
                            <StackPanel>
                                <TextBlock Text="Цвета темы" Style="{StaticResource SectionTitle}"/>
                                <ListBox x:Name="ColorTarget" ItemContainerStyle="{StaticResource ChoiceChip}" SelectedIndex="0" Margin="0,0,0,8"
                                         AutomationProperties.Name="Цвет для редактирования">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBoxItem Content="Фон"/>
                                    <ListBoxItem Content="Акцент"/>
                                </ListBox>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="124"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <local:ColorWheel x:Name="ThemeColorWheel" Width="110" Height="110"
                                                      HorizontalAlignment="Left" AutomationProperties.Name="Цветовой круг"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Яркость" FontWeight="SemiBold"/>
                                        <Slider x:Name="ColorBrightness" Minimum="0" Maximum="100"
                                                IsMoveToPointEnabled="True" AutomationProperties.Name="Яркость цвета"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Border x:Name="ColorSwatch" Width="32" Height="32" CornerRadius="8"
                                                    Margin="0,0,8,0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"/>
                                            <TextBox x:Name="ColorInput" Width="92" Height="32" MaxLength="7" Padding="9,0"
                                                     VerticalContentAlignment="Center" AutomationProperties.Name="HEX-код цвета"
                                                     TextChanged="ColorInput_TextChanged" LostKeyboardFocus="ColorInput_LostKeyboardFocus"/>
                                        </WrapPanel>
                                        <Button x:Name="ResetColorButton" Content="Сбросить цвет" HorizontalAlignment="Left"
                                                Click="ResetColor_Click" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ColorHint" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ThemeMuted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Приложения" Tag="&#xE8B9;">
                <ScrollViewer x:Name="AppsScroll" Style="{StaticResource SettingsPageScroll}" VerticalScrollBarVisibility="Auto">
                <Grid MinHeight="382" Height="{Binding ViewportHeight, ElementName=AppsScroll}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="+ Режим" Click="AddMode_Click"/>
                                <TextBlock Text="Режимы" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ListBox x:Name="ModeList" Grid.Row="1" DisplayMemberPath="Name" MaxHeight="76" Margin="0,4,0,0"
                                     AutomationProperties.Name="Режимы"
                                     AllowDrop="True" PreviewMouseLeftButtonDown="ModeList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="ModeList_PreviewMouseMove"
                                     DragOver="ModeList_DragOver" Drop="ModeList_Drop"
                                     SelectionChanged="ModeList_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ChoiceChip}">
                                        <Setter Property="ContextMenu" Value="{StaticResource ModeActions}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource PanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <Button x:Name="BackToModeButton" DockPanel.Dock="Left" Content="Назад" Click="BackToMode_Click"
                                        Margin="0,0,8,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="EntriesHeading" Text="В этом режиме" FontSize="16"
                                           FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <ListBox x:Name="EntryList" Grid.Row="1" AutomationProperties.Name="Пункты режима"
                                     SelectionChanged="EntryList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="31" Height="31" HorizontalAlignment="Left" CornerRadius="6"
                                                    Background="{DynamicResource ThemeControl}">
                                                <Image Width="21" Height="21" TextElement.Foreground="{DynamicResource ThemeText}">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource EntryIcon}">
                                                            <Binding/>
                                                            <Binding Path="(TextElement.Foreground)" RelativeSource="{RelativeSource Self}"/>
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource ThemeMuted}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Подменю"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Submenu}" Value="{x:Null}">
                                                                    <Setter Property="Text" Value="{Binding Target}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <WrapPanel>
                                    <Button Content="+ Добавить приложение" Click="AddInstalledApp_Click"
                                            Style="{StaticResource PrimaryButton}" Margin="0,0,6,6"/>
                                    <Button Content="Другие…" Click="OtherSources_Click" Margin="0,0,0,6">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Из запущенных приложений…" Click="AddRunningApp_Click"/>
                                                <MenuItem Header="Выбрать файл или ярлык…" Click="AddApp_Click"/>
                                                <MenuItem Header="Добавить папку…" Click="AddFolder_Click"/>
                                                <MenuItem Header="Добавить сайт…" Click="AddSite_Click"/>
                                                <MenuItem x:Name="AddSubmenuItem" Header="Создать подменю…" Click="AddSubmenu_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </WrapPanel>
                                <WrapPanel>
                                    <Button x:Name="EditSubmenuButton" Content="Открыть подменю" Click="EditSubmenu_Click"
                                            Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <Button Content="Имя" Click="RenameEntry_Click" Margin="0,0,6,0"/>
                                    <Button Content="Удалить" Click="DeleteEntry_Click" Margin="0,0,6,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="WidgetsTab" Header="Виджеты" Tag="&#xECA5;">
                <ScrollViewer Style="{StaticResource SettingsPageScroll}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock x:Name="WidgetSettingsHeading" Text="Виджеты рабочего стола" Style="{StaticResource SectionTitle}"/>
                                <ListBox x:Name="DesktopWidgetChoice" ItemContainerStyle="{StaticResource ChoiceChip}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                          AutomationProperties.Name="Виджет рабочего стола" Margin="0,3,0,5"
                                          SelectionChanged="DesktopWidgetChanged">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                <CheckBox x:Name="PinDesktopWidget" Content="Закрепить на рабочем столе" Click="PinDesktopWidget_Click"/>
                                <CheckBox x:Name="DesktopWidgetDetail" Content="Показывать подпись под значением" Click="DesktopWidgetDetail_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Показатели на колесе" Style="{StaticResource SectionTitle}"/>
                                <CheckBox x:Name="StatusRingToggle" Content="Кольцо состояния" Margin="0,3,0,0"
                                          ToolTip="Процессор, громкость, заряд и таймер по краю колеса"/>
                                <UniformGrid x:Name="StatusMetricChoices" Columns="2" Margin="0,2,0,0"
                                             AutomationProperties.Name="Показатели кольца состояния">
                                    <UniformGrid.Resources>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                            <Setter Property="Margin" Value="0,0,12,0"/>
                                        </Style>
                                    </UniformGrid.Resources>
                                    <CheckBox Content="ЦП" Tag="{x:Static local:StatusMetrics.Cpu}" Click="StatusMetric_Click"/>
                                    <CheckBox Content="ГП" Tag="{x:Static local:StatusMetrics.Gpu}" Click="StatusMetric_Click"/>
                                    <CheckBox Content="ОЗУ" Tag="{x:Static local:StatusMetrics.Memory}" Click="StatusMetric_Click"/>
                                    <CheckBox Content="Диск" Tag="{x:Static local:StatusMetrics.Disk}" Click="StatusMetric_Click"/>
                                    <CheckBox Content="Звук" Tag="{x:Static local:StatusMetrics.Audio}" Click="StatusMetric_Click"/>
                                    <CheckBox Content="Заряд" Tag="{x:Static local:StatusMetrics.Battery}" Click="StatusMetric_Click"/>
                                    <CheckBox Content="Сеть" Tag="{x:Static local:StatusMetrics.Network}" Click="StatusMetric_Click"/>
                                    <CheckBox Content="Таймер" Tag="{x:Static local:StatusMetrics.Timer}" Click="StatusMetric_Click"/>
                                </UniformGrid>
                                <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource ThemeMuted}" FontSize="12"
                                           Text="Щёлкни дугу, чтобы закрепить виджет. Shift + щелчок по таймеру запускает или останавливает отсчёт."
                                           TextWrapping="Wrap"/>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Управление" Tag="&#xE765;">
                <ScrollViewer Style="{StaticResource SettingsPageScroll}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="Выбор и навигация" Style="{StaticResource SectionTitle}"/>
                                <CheckBox x:Name="ReleaseSelectionToggle" Content="Выбирать отпусканием"
                                          Click="BehaviorToggle_Click"/>
                                <TextBlock Margin="0,4,0,9" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}"
                                           Text="Удерживай горячую клавишу или боковую кнопку, наведи курсор на сектор и отпусти."/>
                                <CheckBox x:Name="SubmenusToggle" Content="Показывать подменю в колесе"
                                          Click="BehaviorToggle_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Игры" Style="{StaticResource SectionTitle}"/>
                                <CheckBox x:Name="GamePauseToggle" Content="Пауза в выбранных играх" Click="BehaviorToggle_Click"/>
                                <TextBlock Margin="0,4,0,8" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}"
                                           Text="Когда окно игры активно, колесо не открывается, а боковые кнопки работают в игре."/>
                                <CheckBox x:Name="HideWidgetsInGamesToggle" Content="Скрывать виджеты в играх"
                                          Click="WidgetGameOptions_Click" Margin="0,0,0,5"/>
                                <CheckBox x:Name="CompactWidgetsInGamesToggle" Content="Компактный режим виджетов в играх"
                                          Click="WidgetGameOptions_Click"/>
                                <TextBlock Margin="0,4,0,8" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}"
                                           Text="В этом режиме активная игра получает клики сквозь карточки. Скрытие виджетов имеет приоритет."/>
                                <ListBox x:Name="GameList" MaxHeight="106" DisplayMemberPath="Name"
                                         AutomationProperties.Name="Игры для паузы" SelectionChanged="GameList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="ToolTip" Value="{Binding Path}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="+ Из запущенных" Click="AddRunningGame_Click" Margin="0,0,6,4"/>
                                    <Button Content="Выбрать EXE…" Click="AddGameFile_Click" Margin="0,0,6,4"/>
                                    <Button x:Name="RemoveGameButton" Content="Убрать" Click="RemoveGame_Click" IsEnabled="False"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ServiceTab" Header="Система" Tag="&#xE713;">
                <ScrollViewer Style="{StaticResource SettingsPageScroll}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Запись экрана" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Монитор под курсором · MP4 без звука"
                                       Foreground="{DynamicResource ThemeMuted}" Margin="0,0,0,7" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <Button x:Name="RecordScreenButton" Content="Начать запись" Click="RecordScreen_Click"
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"/>
                                <Button Content="Папка записей" Click="OpenRecordings_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="RecordingStatus" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource ThemeMuted}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <CheckBox x:Name="WindowsStartupToggle" Content="Автозапуск с Windows"
                                      Click="WindowsStartupToggle_Click"/>
                            <TextBlock x:Name="WindowsStartupStatus" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource ThemeMuted}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Обновления" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Margin="0,0,0,9"
                                       Foreground="{DynamicResource ThemeMuted}"/>
                            <ProgressBar x:Name="UpdateProgress" Height="7" Margin="0,0,0,12" Visibility="Collapsed"
                                         AutomationProperties.Name="Ход обновления"
                                         Foreground="{DynamicResource ThemeAccent}" Background="{DynamicResource ThemeControl}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
                                            <Grid x:Name="PART_Track">
                                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Width="0"
                                                        Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                            <WrapPanel>
                                <Button x:Name="CheckUpdateButton" Content="Проверить обновления" Click="CheckUpdates_Click"
                                        Margin="0,0,6,0"/>
                                <Button x:Name="InstallUpdateButton" Content="Установить" Click="InstallUpdate_Click"
                                        Style="{StaticResource PrimaryButton}" Visibility="Collapsed"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ReportCard" Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                        <Button x:Name="ReportButton" Content="Сообщить об ошибке или предложить идею"
                                Click="BugReport_Click" HorizontalAlignment="Left"/>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border x:Name="PreviewPanel" Grid.Row="1" Grid.Column="2" Style="{StaticResource PanelCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition x:Name="WheelColumn" Width="0"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="PreviewHeading" Margin="1,0,0,10">
                    <TextBlock Text="Предпросмотр" Style="{StaticResource SectionTitle}" Margin="0"/>
                    <TextBlock Text="{Binding SelectedItem.Name, ElementName=ModeList}" Margin="0,3,0,0"
                               Foreground="{DynamicResource ThemeMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border x:Name="WheelStage" Grid.Row="1" CornerRadius="16" Background="{DynamicResource PreviewStage}"
                        BorderBrush="{DynamicResource SettingsEdge}" BorderThickness="1">
                    <Grid>
                        <Rectangle Fill="{StaticResource StageDots}" Margin="10" IsHitTestVisible="False"/>
                        <Viewbox StretchDirection="DownOnly" Margin="4">
                            <Grid Width="400" Height="400">
                                <local:RadialView x:Name="Preview" IsPreview="True"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Viewbox>
                    </Grid>
                </Border>
                <TextBlock x:Name="PreviewHint" Grid.Row="2" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource ThemeMuted}" Margin="1,10,1,0"
                           Text="Нажми ярлык для просмотра эффекта. Перетащи его, чтобы изменить порядок."/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="4,10,0,0">
            <Button DockPanel.Dock="Right" Content="Выйти из RadialMenu" Click="Exit_Click"/>
            <DockPanel LastChildFill="True" Margin="0,0,8,0">
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ThemeMuted}" Text="Открыть колесо"/>
                <Button x:Name="HotkeyButton" Margin="8,0,0,0" Click="HotkeyButton_Click"
                        AutomationProperties.Name="Изменить горячую клавишу"/>
                <TextBlock x:Name="HotkeyStatus" VerticalAlignment="Center" Margin="10,0,12,0"
                           Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap"/>
            </DockPanel>
        </DockPanel>
    </Grid>
</Window>
