<Window x:Class="RadialMenu1.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RadialMenu1"
        Title="RadialMenu — настройки" Icon="/RadialMenu1;component/app.ico" Width="930" Height="560"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        Foreground="{DynamicResource ThemeText}" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:EntryIconConverter x:Key="EntryIcon"/>
            <ContextMenu x:Key="ModeActions" Opened="ModeMenu_Opened">
                <MenuItem Header="Сделать активным" Click="ActivateMode_Click"/>
                <MenuItem Header="Переименовать" Click="RenameMode_Click"/>
                <MenuItem Header="Удалить" Click="DeleteMode_Click"/>
            </ContextMenu>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="WindowSurface" Margin="14" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="WindowScale"/>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="438"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="3" Grid.RowSpan="2" Margin="-14" CornerRadius="16"
                Background="{DynamicResource ThemeWindow}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"/>

        <TabControl x:Name="SettingsTabs" SelectionChanged="SettingsTabs_SelectionChanged"
                    SizeChanged="SettingsTabs_SizeChanged">
            <TabItem Header="Приложения">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="116"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Режимы" Style="{StaticResource SectionTitle}"/>
                            <ListBox x:Name="ModeList" Grid.Row="1" DisplayMemberPath="Name"
                                     AutomationProperties.Name="Режимы"
                                     AllowDrop="True" PreviewMouseLeftButtonDown="ModeList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="ModeList_PreviewMouseMove"
                                     DragOver="ModeList_DragOver" Drop="ModeList_Drop"
                                     SelectionChanged="ModeList_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="ContextMenu" Value="{StaticResource ModeActions}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <Button Grid.Row="2" Content="+ Режим" Click="AddMode_Click" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <Button x:Name="BackToModeButton" DockPanel.Dock="Left" Content="Назад" Click="BackToMode_Click"
                                        Margin="0,0,8,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="EntriesHeading" Text="В этом режиме" FontSize="16"
                                           FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <ListBox x:Name="EntryList" Grid.Row="1" AutomationProperties.Name="Пункты режима"
                                     SelectionChanged="EntryList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="31" Height="31" HorizontalAlignment="Left" CornerRadius="6"
                                                    Background="{DynamicResource ThemeControl}">
                                                <Image Width="21" Height="21" TextElement.Foreground="{DynamicResource ThemeText}">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource EntryIcon}">
                                                            <Binding/>
                                                            <Binding Path="(TextElement.Foreground)" RelativeSource="{RelativeSource Self}"/>
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource ThemeMuted}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Подменю"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Submenu}" Value="{x:Null}">
                                                                    <Setter Property="Text" Value="{Binding Target}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <WrapPanel>
                                    <Button Content="+ Добавить приложение" Click="AddInstalledApp_Click"
                                            Style="{StaticResource PrimaryButton}" Margin="0,0,6,6"/>
                                    <Button Content="Другие…" Click="OtherSources_Click" Margin="0,0,0,6">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Из запущенных приложений…" Click="AddRunningApp_Click"/>
                                                <MenuItem Header="Выбрать файл или ярлык…" Click="AddApp_Click"/>
                                                <MenuItem Header="Добавить папку…" Click="AddFolder_Click"/>
                                                <MenuItem Header="Добавить сайт…" Click="AddSite_Click"/>
                                                <MenuItem x:Name="AddSubmenuItem" Header="Создать подменю…" Click="AddSubmenu_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </WrapPanel>
                                <WrapPanel>
                                    <Button x:Name="EditSubmenuButton" Content="Открыть подменю" Click="EditSubmenu_Click"
                                            Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <Button Content="Имя" Click="RenameEntry_Click" Margin="0,0,6,0"/>
                                    <Button Content="Удалить" Click="DeleteEntry_Click" Margin="0,0,6,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Тема">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="Оформление" Style="{StaticResource SectionTitle}"/>
                                <ListBox x:Name="ThemeList" SelectedValuePath="Value"
                                         AutomationProperties.Name="Оформление"
                                         SelectionChanged="ThemeList_SelectionChanged">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Margin" Value="0,0,4,4"/>
                                            <Setter Property="Padding" Value="6,6"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Grid Width="18" Height="18" Margin="0,0,6,0">
                                                    <Ellipse Fill="{Binding Surface}" Stroke="{Binding Accent}"/>
                                                    <Ellipse Width="6" Height="6" Fill="{Binding Accent}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" FontSize="12"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Цвета темы" Style="{StaticResource SectionTitle}"/>
                                <ListBox x:Name="ColorTarget" SelectedIndex="0" Margin="0,0,0,8"
                                         AutomationProperties.Name="Цвет для редактирования">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBoxItem Content="Фон"/>
                                    <ListBoxItem Content="Акцент"/>
                                </ListBox>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="158"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <local:ColorWheel x:Name="ThemeColorWheel" Width="142" Height="142"
                                                      HorizontalAlignment="Left" AutomationProperties.Name="Цветовой круг"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Яркость" FontWeight="SemiBold"/>
                                        <Slider x:Name="ColorBrightness" Minimum="0" Maximum="100"
                                                IsMoveToPointEnabled="True" AutomationProperties.Name="Яркость цвета"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Border x:Name="ColorSwatch" Width="32" Height="32" CornerRadius="8"
                                                    Margin="0,0,8,0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"/>
                                            <TextBox x:Name="ColorInput" Width="92" Height="32" MaxLength="7" Padding="9,0"
                                                     VerticalContentAlignment="Center" AutomationProperties.Name="HEX-код цвета"
                                                     TextChanged="ColorInput_TextChanged" LostKeyboardFocus="ColorInput_LostKeyboardFocus"/>
                                        </WrapPanel>
                                        <Button x:Name="ResetColorButton" Content="Сбросить цвет" HorizontalAlignment="Left"
                                                Click="ResetColor_Click" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ColorHint" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ThemeMuted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource ThemeMuted}"
                                               Text="{Binding Value, ElementName=MenuScale, StringFormat={}{0:0}%}"/>
                                    <TextBlock Text="Размер колеса" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Slider x:Name="MenuScale"
                                        IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                        AutomationProperties.Name="Размер колеса в процентах"/>
                                <DockPanel Margin="0,7,0,0">
                                    <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource ThemeMuted}"
                                               Text="{Binding Value, ElementName=MenuTransparency, StringFormat={}{0:0}%}"/>
                                    <TextBlock Text="Прозрачность фона" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Slider x:Name="MenuTransparency" Minimum="0" Maximum="100" TickFrequency="1"
                                        SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True" AutomationProperties.Name="Прозрачность фона в процентах"/>
                                <CheckBox x:Name="AnimationsToggle" Content="Анимации и свечение" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Управление">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <CheckBox x:Name="ReleaseSelectionToggle" Content="Выбирать отпусканием"
                                          Click="BehaviorToggle_Click"/>
                                <TextBlock Margin="0,4,0,9" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}"
                                           Text="Удерживай горячую клавишу или боковую кнопку, наведи курсор на сектор и отпусти."/>
                                <CheckBox x:Name="SubmenusToggle" Content="Показывать подменю в колесе"
                                          Click="BehaviorToggle_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                            <StackPanel>
                                <CheckBox x:Name="GamePauseToggle" Content="Пауза в выбранных играх" Click="BehaviorToggle_Click"/>
                                <TextBlock Margin="0,4,0,8" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}"
                                           Text="Когда окно игры активно, колесо не открывается, а боковые кнопки работают в игре."/>
                                <ListBox x:Name="GameList" Height="106" DisplayMemberPath="Name"
                                         AutomationProperties.Name="Игры для паузы" SelectionChanged="GameList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="ToolTip" Value="{Binding Path}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="+ Из запущенных" Click="AddRunningGame_Click" Margin="0,0,6,4"/>
                                    <Button Content="Выбрать EXE…" Click="AddGameFile_Click" Margin="0,0,6,4"/>
                                    <Button x:Name="RemoveGameButton" Content="Убрать" Click="RemoveGame_Click" IsEnabled="False"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ServiceTab" Header="Приложение">
                <StackPanel>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <CheckBox x:Name="WindowsStartupToggle" Content="Автозапуск с Windows"
                                      Click="WindowsStartupToggle_Click"/>
                            <TextBlock x:Name="WindowsStartupStatus" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource ThemeMuted}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Обновления" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Margin="0,0,0,9"
                                       Foreground="{DynamicResource ThemeMuted}"/>
                            <ProgressBar x:Name="UpdateProgress" Height="7" Margin="0,0,0,12" Visibility="Collapsed"
                                         AutomationProperties.Name="Ход обновления"
                                         Foreground="{DynamicResource ThemeAccent}" Background="{DynamicResource ThemeControl}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
                                            <Grid x:Name="PART_Track">
                                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Width="0"
                                                        Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                            <WrapPanel>
                                <Button x:Name="CheckUpdateButton" Content="Проверить обновления" Click="CheckUpdates_Click"
                                        Margin="0,0,6,0"/>
                                <Button x:Name="InstallUpdateButton" Content="Установить" Click="InstallUpdate_Click"
                                        Style="{StaticResource PrimaryButton}" Visibility="Collapsed"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ReportCard" Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                        <Button x:Name="ReportButton" Content="Сообщить об ошибке или предложить идею"
                                Click="BugReport_Click" HorizontalAlignment="Left"/>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Column="2" Style="{StaticResource PanelCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Background="Transparent" Margin="0,0,0,6"
                           MouseLeftButtonDown="PreviewHeader_MouseLeftButtonDown">
                    <Button x:Name="CloseSettingsButton" DockPanel.Dock="Right" Width="34" Height="32"
                            Padding="0" ToolTip="Закрыть настройки" AutomationProperties.Name="Закрыть настройки"
                            Click="CloseSettings_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ThemeHover}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <TextBlock Text="Предпросмотр" Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                </DockPanel>
                <local:RadialView Grid.Row="1" x:Name="Preview" IsPreview="True"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeMuted}"
                           Text="Перетащи значок, чтобы изменить порядок. На рабочем колесе ПКМ открывает настройки."/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Выйти из RadialMenu" Click="Exit_Click"/>
            <DockPanel LastChildFill="True" Margin="0,0,8,0">
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ThemeMuted}" Text="Открыть колесо"/>
                <Button x:Name="HotkeyButton" Margin="8,0,0,0" Click="HotkeyButton_Click"
                        AutomationProperties.Name="Изменить горячую клавишу"/>
                <TextBlock x:Name="HotkeyStatus" VerticalAlignment="Center" Margin="10,0,12,0"
                           Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap"/>
            </DockPanel>
        </DockPanel>
    </Grid>
</Window>
